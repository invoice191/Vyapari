# Core Supabase Configuration (Required for Frontend)
VITE_SUPABASE_URL="your-project-url"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Core Supabase Configuration (Required for Scripts/CLI)
SUPABASE_URL="your-project-url"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Integration
VITE_GEMINI_API_KEY="AIzaSy..."
GOOGLE_VISION_API_KEY="AIzaSy..."

# Telegram Bot
TELEGRAM_BOT_TOKEN="123456789:ABC..."

# Internal API Auth
VITE_API_AUTH_TOKEN="generate-a-uuid-or-secret"
API_AUTH_TOKEN="must-match-vite-api-auth-token"

# Payment Gateways
VITE_RAZORPAY_KEY_ID="rzp_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Communications (Twilio)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="auth_token"
TWILIO_FROM_PHONE="+1..."
TWILIO_MESSAGING_SERVICE_SID="MG..."

# Reminders & Automations
REMINDER_AUTO_RUN="true"
REMINDER_AUTO_RUN_MINUTES="60"
REMINDER_INTERVAL_HOURS="48"

# Feature Flags
VYAPARI_ENABLE_LIVE_APIS="true"
VITE_APP_VERSION="1.0.0"
NODE_ENV="development"

# Testing Sandbox Accounts
SMOKE_SUPABASE_EMAIL="tester@example.com"
SMOKE_SUPABASE_PASSWORD="password123"
